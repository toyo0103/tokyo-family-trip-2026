            "type": "transit",
            "method": "bus",
            "route": [
              "安川町",
              "中禅寺温泉"
            ],
            "duration": "43 min",
            "notes": "巴士名稱：日光駅～光徳温泉～湯元温泉 (湯元温泉行)",
            "timeRange": ""
          },
